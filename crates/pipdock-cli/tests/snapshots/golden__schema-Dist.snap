---
source: crates/pipdock-cli/tests/golden.rs
expression: out
---
{
  "$defs": {
    "PkgName": {
      "description": "A PEP 503-normalized distribution name.\n\nConstructing one is the *only* way a package name reaches an argv array, which is what makes\nSECURITY §2's \"validated before it reaches argv\" claim structural rather than aspirational.",
      "type": "string"
    },
    "Version": {
      "description": "A version string as the engine reported it. Never reshaped or localized (I18N §2).",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An installed distribution, as read by `probe.py` or `<engine> list`.",
  "properties": {
    "name": {
      "$ref": "#/$defs/PkgName",
      "description": "Normalized distribution name."
    },
    "requiresDist": {
      "default": [],
      "description": "Raw `Requires-Dist` entries. The reverse-dependency graph is built from these.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requiresPython": {
      "default": null,
      "description": "Raw `Requires-Python` specifier, when declared.",
      "type": [
        "string",
        "null"
      ]
    },
    "sizeBytes": {
      "description": "Installed size in bytes, summed from the distribution's RECORD manifest.\n\n`None` means \"not knowable\", and is deliberately not `0`: `.egg-info` distributions have\nno RECORD, and a PEP 660 editable install has one that lists only its import shim, so\nsumming it reports a few hundred bytes for a project of any size. Only `probe.py` can\nsupply this — `<engine> list --format=json` does not report it — so it is always `None`\non a `Dist` that came from an engine.\n\nA lower bound even when present: uncompressed bytes as recorded at install time,\nexcluding `__pycache__` written afterwards.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "version": {
      "$ref": "#/$defs/Version",
      "description": "Installed version."
    }
  },
  "required": [
    "name",
    "version"
  ],
  "title": "Dist",
  "type": "object"
}
